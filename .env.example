# .env.example - Template for Google OAuth2 Credentials
#
# This is a template for the required environment variables.
# Copy this file to `.env` and fill in your actual credentials.
# This file is safe to commit to version control.
#
# Usage:
# 1. Copy this file to `.env` in your local development environment.
# 2. Replace the placeholder values with your real credentials.
# 3. Never commit your real `.env` file!

# Google OAuth2 Client ID
GOOGLE_CLIENT_ID=your-google-client-id-here

# Google OAuth2 Client Secret
GOOGLE_CLIENT_SECRET=your-google-client-secret-here